{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "cache": true
    },
    "typecheck": {
      "cache": true
    },
    "dev": {
      "cache": false
    },
    "start": {
      "cache": false
    },
    "deploy": {
      "cache": false
    },
    "preview": {
      "cache": false
    }
  }
}
